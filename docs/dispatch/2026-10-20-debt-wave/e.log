  /**
   * BI-11 接线 —— TokenHud 状态跟踪（usage 事件 → 状态行片段）。
   *
   * 数据源：适配器 StreamEvent 的 usage 事件（BI-04.2 面）——input_tokens 为
   * 本次请求的提示词 token 数，cache_read_input_tokens 为命中缓存部分。
   * 渲染器官在 packages/tui/src/hud.ts（TokenHud 确定性单行），本文件只做
   * 「事件 → 状态 → 行片段」三步接线，不改渲染规则。
   *
   * 诚实边界：
   * - 无 usage 事件时状态行不出现 Tokens 段（读数未知不臆造 0）；
   * - 缓存命中率 = cachedInputTokens / inputTokens（两者齐备且分母 > 0 才算）；
   * - maxTokens（上下文窗）由宿主注入（config models.context_limit），缺省 128k。
   */

  import { TokenHud, type TokenHudState } from "../hud";
  import type { StreamUsage } from "../../../core/src/adapters/deepseek-adapter";

  /** 上下文窗缺省值（128k；宿主可按模型 context_limit 覆盖）。 */
  export const DEFAULT_CONTEXT_TOKENS = 128_000;

  export class TokenHudTracker {
  	readonly #hud = new TokenHud();
  	readonly #maxTokens: number;
  	#promptTokens = 0;
  	#cacheHitRate: number | undefined;
  	#hasReading = false;

  	constructor(maxTokens: number = DEFAULT_CONTEXT_TOKENS) {
  		this.#maxTokens = maxTokens > 0 ? maxTokens : DEFAULT_CONTEXT_TOKENS;
  	}

  	/** 喂入一条 usage 读数（最新一次覆盖上一条）。 */
  	update(usage: StreamUsage): void {
  		const input = usage.inputTokens;
  		if (input === undefined) return;
  		this.#promptTokens = input;
  		this.#hasReading = true;
  		const cached = usage.cachedInputTokens;
  		this.#cacheHitRate = cached !== undefined && input > 0 ? cached / input : undefined;
  	}

  	/** 是否已收到读数（无读数则状态行不出 Tokens 段）。 */
  	get hasReading(): boolean { return this.#hasReading; }

  	/** 当前 HUD 状态（快照）。 */
  	get state(): TokenHudState {
  		return {
  			promptTokens: this.#promptTokens,
  			maxTokens: this.#maxTokens,
  			...(this.#cacheHitRate !== undefined ? { cacheHitRate: this.#cacheHitRate } : {}),
  		};
  	}

  	/** 状态行片段：`Tokens: 42k/128k (32%) | Cache: 88%`；无读数返回空串。 */
  	get line(): string {
  		if (!this.#hasReading) return "";
  		return this.#hud.render(this.state);
  	}
  }
  ```

