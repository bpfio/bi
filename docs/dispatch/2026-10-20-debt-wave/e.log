   *
   * 命令对象本体在 core（packages/core/src/commands/compact.ts，只读消费）：
   * 本文件只做两件事——
   * 1. 候选面：三条命令的候选条目（斜杠菜单可发现）；
   * 2. 分发面：把 "/name args" 解析后交给 core 命令对象（parse → execute），
   *    执行体经 CommandContext 端口注入（TUI 侧接，core 不实现紧缩逻辑）。
   */

  import { findGateCommand, type CommandContext, type CommandError } from "../../../core/src/commands/compact";
  import type { Candidate } from "./candidate-menu";

  /** 三命令的候选条目（斜杠菜单可发现；name 不含前导 "/"）。 */
  export const gateCommandCandidates: readonly Candidate[] = [
    { name: "compact", description: "紧缩当前上下文为摘要（可带提示词）" },
    { name: "rewind", description: "回退最近 N 轮对话上下文" },
    { name: "clear", description: "清空当前上下文与转录" },
  ];

  export type GateCommandName = "compact" | "rewind" | "clear";

  export type GateDispatchResult =
    | { ok: true; command: GateCommandName }
    | { ok: false; error: CommandError };

  /** 命令行 → 命令名 + 参数体（"/name args" → name/args；非斜杠行 → undefined）。 */
  export function splitGateCommand(line: string): { name: string; args: string } | undefined {
    const trimmed = line.trim();
    if (!trimmed.startsWith("/")) return undefined;
    const body = trimmed.slice(1);
    const sep = body.search(/\s/);
    const name = sep < 0 ? body : body.slice(0, sep);
    const args = sep < 0 ? "" : body.slice(sep).trim();
    return { name, args };
  }

  /**
   * 分发：命中三命令 → core 命令对象 parse(args) → execute(args, ctx)。
   * 未知命令 → unknown-command 结构化错误（不抛）。
   */
  export function dispatchGateCommand(line: string, ctx: CommandContext): GateDispatchResult {
    const split = splitGateCommand(line);
    if (split === undefined) {
