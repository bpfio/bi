  ```ts
  export function dispatchGateCommand(line: string, ctx: CommandContext): GateDispatchResult {
  	const trimmed = line.trim();
  	if (!trimmed.startsWith("/")) return { ok: false, error: { code: "unknown-command", message: `未知命令: ${trimmed.split(/\s+/)[0] ?? ""}` } };
  	const head = trimmed.slice(1).split(/\s+/)[0] ?? "";
