  ```ts
  /**
   * BI-11 接线 —— TokenHud 状态跟踪：适配器 usage 事件 → HUD 单行渲染。
   *
   * 数据源（钉死）：模型流的 usage 事件（StreamUsage）——inputTokens = 本次请求
   * 的提示词占用（= 视窗水位），cachedInputTokens = 命中缓存的提示词部分；
   * 缓存命中率 = cached / input（input > 0 且两者齐备时才有值，缺省则 HUD 省略
   * Cache 段——渲染规则归 ../hud.ts 器官）。
   *
   * maxTokens（视窗容量）由宿主注入（config models.entries.*.context_limit），
   * 缺省 128k（与 HUD 钉死样例 42k/128k 同量级）。
   */

  import { TokenHud, type TokenHudState } from "../hud";
  import type { StreamUsage } from "../../../core/src/adapters/deepseek-adapter";

  /** 视窗容量缺省值（宿主未注入 context_limit 时）。 */
  export const DEFAULT_CONTEXT_TOKENS = 128_000;

  export class TokenHudTracker {
  	readonly #hud = new TokenHud();
  	readonly #maxTokens: number;
  	#promptTokens = 0;
  	#cacheHitRate: number | undefined;
  	#seen = false;

  	constructor(maxTokens: number = DEFAULT_CONTEXT_TOKENS) {
  		this.#maxTokens = maxTokens > 0 ? maxTokens : DEFAULT_CONTEXT_TOKENS;
  	}

  	/** 喂入一条 usage 事件（缺字段不覆盖既有读数）。 */
  	update(usage: StreamUsage): void {
  		if (usage.inputTokens !== undefined) {
  			this.#promptTokens = usage.inputTokens;
  			this.#seen = true;
  			if (usage.cachedInputTokens !== undefined && usage.inputTokens > 0) {
  				this.#cacheHitRate = usage.cachedInputTokens / usage.inputTokens;
  			}
  		}
  	}

  	/** 是否已收到 usage 读数（未收到则状态行不挂 HUD 段）。 */
  	get hasReading(): boolean { return this.#seen; }

  	/** HUD 状态（渲染单一来源）。 */
  	get state(): TokenHudState {
  		return this.#cacheHitRate === undefined
  			? { promptTokens: this.#promptTokens, maxTokens: this.#maxTokens }
