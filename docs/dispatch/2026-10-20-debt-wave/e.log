/**
 * BI-10 · 80% 高水位静默自动紧缩器（AutoCompactor）。
 *
 * 协作契约（钉死）：
 *  - 水位未超 → 返回 null（零开销静默路径）；
 *  - 水位超 → 调 summarizer（模型调用端口，注入）生成摘要 → 产出
 *    CompactionEntry { summary, tokensBefore, prunedFiles, keptMessages } →
 *    新消息序列 = [头部 system 消息...] + CompactionEntry 占位 + 保留轮次；
 *  - 组装必须过 BI-10.2 findSafeCut 门禁：保留起点向回扩窗直到切点安全
 *    （open=0 且 orphan=0）；
 *  - summarizer 抛错 → 结构化失败记入 lastFailure，返回 null，不炸调用方，
 *    熔断器不计数（紧缩未发生）；
 *  - 连续 3 次紧缩后水位仍超（WindowManager 3 击熔断）→ 第 4 次尝试抛
 *    CompactionCircuitOpenError（结构化告警）。
 *
 * 裁定（工单未覆盖处）：
 *  1. 保留起点 preferred = 倒数第 keepRecentTurns 个 user 消息；user 轮数
 *     不足或 preferred=0（无历史可摘要）→ 返回 null，不空转紧缩；
 *  2. findSafeCut 扩窗到 0（头部即不可配平的病态序列）→ 同上返回 null；
 *  3. summarizer 输入为切点前的**会话部分**（剥离头部 system run）；
 *  4. CompactionEntry 占位 = { role: "user", content: "[compacted] <summary>" }
 *     （user 形态对上游 API 兼容性最稳）；
 *  5. prunedFiles 从切点前消息启发式提取：对象内容按
 *     file_path/path/filename/file 键深走查，字符串内容按绝对 POSIX 路径
 *     正则；写入类工具名（write/edit/patch/apply/create/save/move/remove/
 *     delete）归 modifiedFiles，其余归 readFiles；同桶去重保序。
 */

import { findSafeCut, type Msg } from "./tool-pairing";
import { COMPACT_WATERMARK, type WindowManager } from "./window-manager";

/** 模型调用端口；测试注入 stub。 */
export type Summarizer = (msgs: Msg[]) => Promise<string>;

export interface TouchedFiles {
  readFiles: string[];
  modifiedFiles: string[];
}

export interface CompactionEntry {
  summary: string;
  /** 紧缩前最后一次用量读数（promptTokens）。 */
  tokensBefore: number;
  prunedFiles: TouchedFiles;
  keptMessages: Msg[];
}

export interface CompactResult {
  messages: Msg[];
  entry: CompactionEntry;
}

export interface AutoCompactorDeps {
  summarizer: Summarizer;
  window: WindowManager;
  /** 逐字保留的最近 user 轮数。默认 2。 */
  keepRecentTurns?: number;
}

/** summarizer 端口失败的结构化留痕（不抛出，记入 lastFailure）。 */
export interface CompactionFailure {
  code: "BI-COMPACTION-SUMMARIZER-FAILED";
  message: string;
}

/** 熔断告警：连续 3 次紧缩后水位仍超。 */
export class CompactionCircuitOpenError extends Error {
  readonly code = "BI-COMPACTION-CIRCUIT-OPEN";
  constructor(
    message: string,
    readonly strikes: number,
    readonly ratio: number,
  ) {
    super(message);
    this.name = "CompactionCircuitOpenError";
  }
}

const WRITE_TOOL_RE = /(write|edit|patch|apply|create|save|move|remove|delete)/i;
const FILE_KEYS = new Set(["file_path", "path", "filename", "file"]);
=====RECOVERY=====
/**
 * BI-10.1 · 历史回溯定位指针与断点自恢复协议。
 *
 * 生成 `## Context Recovery` 结构化尾块：把已压缩 window 在持久化 JSONL
 * wire 中的行号区间（1 基，含首尾）随摘要一起持久化。断点恢复后，模型
 * 可按行号 grep+read 回溯历史原始输出，而非凭记忆复述。
 *
 * 渲染契约（钉死）：
 *  - 首行 `## Context Recovery`；字段序固定：logPath → windows → tip；
 *  - 每个 window 两行：`- lines: <from>-<to>` 与 `  summary: <摘要>`；
 *  - windows 按 from 升序（并列按 to）——乱序输入自动排序，输出确定；
 *  - 无时间戳、无随机源：同输入两次渲染逐字节相等；
 *  - summary/tip 中的换行（\r\n|\r|\n）展平为单个空格，保证块内每个
 *    window 恰好两行、`lines: ` grep 模式不被破坏（裁定）。
 *
 * 行号语义：1 基——JSONL wire 第 1 行即 from=1。record/build 校验：
 * 非整数、from < 1、to < from 一律 RangeError（from === to 是单行 window，
 * 合法）。
 *
 * 协作契约：与 BI-10 compactor 的 CompactionEntry 协作——组装方负责把本卡
 * 生成的 footer 拼进摘要尾（CompactionEntry.summary 之后），本卡只生成、
 * 不拼接；行号区间由组装方在写 wire 时登记，本卡不读 wire。
 */

export const DEFAULT_RECOVERY_TIP =
  "需要历史原始输出时按行号 grep+read 检视，勿凭记忆复述";

const HEADER = "## Context Recovery";

export interface RecoveryWindowRange {
  /** window 在持久化 JSONL wire 中的起始行号（1 基，含） */
  from: number;
  /** window 在持久化 JSONL wire 中的结束行号（1 基，含） */
  to: number;
  /** 该 window 的内容摘要 */
  summary: string;
}

export interface RecoveryFooterOptions {
  /** 持久化 JSONL wire 路径（由注入方提供） */
  logPath: string;
  /** 各 window 的历史行号区间与摘要 */
  windows: readonly RecoveryWindowRange[];
  /** 回溯提示语（缺省使用内置 tip） */
  tip?: string;
}

function flatten(value: string): string {
  return value.replace(/\r\n|\r|\n/g, " ");
}

/** 行号区间校验：整数、1 基（from >= 1）、to >= from。 */
function assertValidRange(from: number, to: number): void {
  if (!Number.isInteger(from) || !Number.isInteger(to)) {
    throw new RangeError(
      `window line numbers must be integers, got from=${String(from)} to=${String(to)}`,
    );
  }
  if (from < 1) {
    throw new RangeError(`window line numbers are 1-based, got from=${String(from)}`);
  }
  if (to < from) {
    throw new RangeError(`window range inverted: from=${String(from)} to=${String(to)}`);
  }
}

/**
 * 生成 `## Context Recovery` 结构化块（确定性渲染，字段序固定）。
 * 输入 windows 乱序时自动按 (from, to) 排序，不改变调用方数组。
