  		return { ok: false, error: { code: "unknown-command", message: `未知命令: ${head}` } };
  	}
  	const rest = trimmed.slice(1 + head.length).trim();
  	switch (head) {
  		case "compact": {
  			const parsed = compactCommand.parse(rest);
  			if (!parsed.ok) return { ok: false, error: parsed.error };
  			compactCommand.execute(parsed.args, ctx);
  			return { ok: true, command: "compact" };
  		}
  		case "rewind": {
  			const parsed = rewindCommand.parse(rest);
  			if (!parsed.ok) return { ok: false, error: parsed.error };
  			rewindCommand.execute(parsed.args, ctx);
  			return { ok: true, command: "rewind" };
  		}
  		case "clear": {
  			const parsed = clearCommand.parse(rest);
  			if (!parsed.ok) return { ok: false, error: parsed.error };
  			clearCommand.execute(parsed.args, ctx);
  			return { ok: true, command: "clear" };
  		}
  	}
  }
