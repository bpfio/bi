    if (command === undefined) {
      return { ok: false, error: { code: "unknown-command", message: `未知命令: /${split.name}` } };
    }
    const parsed = command.parse(split.args);
    if (!parsed.ok) return { ok: false, error: parsed.error };
    command.execute(parsed.args, ctx);
    return { ok: true, command: command.name };
  }
