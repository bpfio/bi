  	/** /compact 内建执行体：把当前上下文摘要化，替换为单条 [compacted] 摘要。 */
  	async #compactContext(prompt?: string): Promise<void> {
  		const before = this.#messages.length;
  		if (before === 0) { this.#gateReport = "[compact] 无上下文可紧缩"; return; }
  		const focus = prompt === undefined || prompt.trim() === "" ? "" : `\n额外要求：${prompt.trim()}`;
  		const instruction = `请把下面的对话压缩为要点摘要（保留结论、决策与未完成事项）：${focus}\n\n${renderMessagesForSummary(this.#messages)}`;
  		let summary = "";
  		try {
  			for await (const event of this.#model.stream({ messages: [{ role: "user", content: instruction }], tools: [] })) {
  				if (event.type === "content_delta") summary += event.delta;
  				else if (event.type === "error") throw new Error(`${event.error.code}: ${event.error.message}`);
  			}
  		} catch (error) {
  			this.#gateReport = `[compact] 紧缩失败（上下文未变）：${message(error)}`;
  			return;
  		}
  		if (summary.trim() === "") { this.#gateReport = "[compact] 摘要为空（上下文未变）"; return; }
  		this.#messages = [{ role: "user", content: `[compacted] ${summary.trim()}` }];
  		await this.#appendChained({ type: "compaction", payload: { summary: summary.trim(), tokensBefore: this.#hud.promptTokens, messagesBefore: before } as unknown as JsonValue });
  		this.#gateReport = `[compact] 上下文已紧缩：${before} 条消息 → 1 条摘要（${summary.trim().length} 字）`;
  	}
  ```

