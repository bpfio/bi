  export function dispatchGateCommand(line: string, exec: GateExecution): GateCommandOutcome {
    const trimmed = line.trim();
    const head = trimmed.split(/\s+/)[0] ?? "";   // "/compact"
    const name = head.startsWith("/") ? head.slice(1) : head;
    const command = findGateCommand(name);
    if (command === undefined) return { handled: false, message: "" };
    const body = trimmed.slice(head.length);
    const parsed = command.parse(body);
    if (!parsed.ok) return { handled: true, message: `${command.usage} —— ${parsed.error.message}` };
    // 执行（core 命令对象为唯一语义源；端口实现体在 TUI 侧）
    command.execute(parsed.args, ctx);
  }
  ```

  The problem: `command.execute(parsed.args, ctx)` — the union type `AnyGateCommand` has `execute(args: A, ctx: CommandContext): void` with A differing per variant. TypeScript will complain when calling execute on the union with a union-typed args. That's why the union type exists... Calling `.execute` on a union of function types: TS 3.3+ supports calling a union of signatures, but the parameters become intersections — `args` would be `({prompt?: string} & {steps: number} & undefined)`. That's a problem.

