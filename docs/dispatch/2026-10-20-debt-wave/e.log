  async #runRewind(steps: number): Promise<void> {
  	const override = this.#gateOverrides.rewind;
  	if (override !== undefined) { await override(steps); this.#gateReport = "[rewind] 已执行（宿主自定义执行体）"; return; }
  	const turns = countUserTurns(this.#messages);   // number of user messages
  	const drop = Math.min(steps, turns);
  	if (drop === 0) { this.#gateReport = "[rewind] 无可回退轮次"; return; }
  	// 保留前 (turns - drop) 个 user 轮次及其后续消息
