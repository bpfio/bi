  ```ts
  /**
   * BI-20.5 接线 —— vis 访问令牌轮转的可选增强装配（tui 侧）。
   *
   * 器官：packages/tui/src/vis/token-rotator.ts（TokenRotator：128-bit 令牌 /
   * 5 分钟轮转 / 60 秒宽限双活）。core 不依赖 tui（依赖方向 core ← tui），
   * 故轮转引擎在本侧装配，经 core 的令牌权威端口（TokenAuthority）注入。
   *
   * 启用方式：环境变量 BI_VIS_TOKEN_ROTATE=1（显式启用；不加 config 键）。
   */

  import { TokenRotator, type TokenRotatorOptions } from "./token-rotator";

  /** 启用令牌轮转的环境变量（值 "1" 才启用；其他值/缺省 = 关闭）。 */
  export const VIS_TOKEN_ROTATE_ENV = "BI_VIS_TOKEN_ROTATE";

  /** 令牌权威端口（与 core/web/vis-handler.ts 的 TokenAuthority 同构）。 */
  export interface VisTokenAuthority {
    current(): string;
    validate(token: string | null | undefined): boolean;
  }

  /** 轮转通知回调（令牌变更时触发；宿主据此重印访问链接）。 */
  export type TokenRotateListener = (token: string) => void;

  /** 判定轮转是否启用（env 值恰为 "1"）。 */
  export function visTokenRotateEnabled(env: string | undefined): boolean {
    return env === "1";
  }

  /**
   * 轮转令牌权威：包 TokenRotator，惰性轮转（引擎内部按周期自转），
   * 令牌变化时回调 onRotate（宿主重印访问链接）。
   */
  export class RotatingTokenAuthority implements VisTokenAuthority {
    #last: string;
    constructor(private readonly rotator: TokenRotator, private readonly onRotate?: TokenRotateListener) {
      this.#last = rotator.current();
    }
    current(): string {
      const token = this.rotator.current();
      this.#notice(token);
      return token;
    }
    validate(token: string | null | undefined): boolean {
      const current = this.current();
      return this.rotator.validate(token);
    }
    #notice(token: string): void {
      if (token === this.#last) return;
      this.#last = token;
      this.onRotate?.(token);
    }
  }

  /** 装配轮转令牌权威（缺省 5 分钟轮转 + 60 秒宽限双活）。 */
  export function createVisTokenAuthority(options: { onRotate?: TokenRotateListener; rotator?: TokenRotatorOptions } = {}): VisTokenAuthority {
    const rotator = new TokenRotator(options.rotator ?? {});
    return new RotatingTokenAuthority(rotator, options.onRotate);
  }
  ```

