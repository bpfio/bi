  const trimmed = line.trim();
  const head = trimmed.split(/\s+/)[0] ?? "";
  if (head !== "/mode") return { ok: false, error: { code: "unknown-command", message: `未知命令: ${head}` } };
  const rest = trimmed.slice(head.length).trim();
  if (rest === "") {
    const mode = selector.getMode();
    return { ok: true, mode, changed: false, message: describeMode(mode) };
  }
  const parts = rest.split(/\s+/);
  if (parts.length > 1) return { ok: false, error: { code: "unexpected-argument", message: `/mode 只接受一个模式参数（plan/edit/build/yolo），收到: ${rest}` } };
  const target = parts[0] as string;
  if (!isModeId(target)) return { ok: false, error: { code: "unknown-mode", message: `未知模式: ${target}（可选 plan/edit/build/yolo）` } };
  const from = selector.getMode();
  selector.setMode(target);
  const changed = from !== target;
  return { ok: true, mode: target, changed, message: ... };
  ```

